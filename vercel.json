{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "tickets",
          "format": "url",
          "env": "TICKETS_SERVICE_URL"
        }
      ]
    },
    "tickets": {
      "root": "services/tickets",
      "framework": "hono",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
