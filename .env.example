# Gemini (gratuito em https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Assina o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio-de-32-bytes

# Serviço de chamados (processo separado). Na Vercel, TICKETS_SERVICE_URL vem do
# binding do vercel.json; defina só TICKETS_SERVICE_TOKEN.
TICKETS_SERVICE_URL=http://localhost:4001
TICKETS_SERVICE_TOKEN=dev-token
TICKETS_PORT=4001
# Simula a instabilidade do sistema legado (0 a 1)
TICKETS_FAILURE_RATE=0.1

# Bancos SQLite locais. Na Vercel, a integração do Turso injeta TURSO_DATABASE_URL
# e TURSO_AUTH_TOKEN, usados quando as variáveis abaixo não estão definidas.
APP_DATABASE_URL=file:../../data/app.db
TICKETS_DATABASE_URL=file:../../data/tickets.db
